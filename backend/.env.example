PORT=4000
# MAMP (Mac) : port 8889, user root, mot de passe root
# MAMP (Windows) : port 3306, user root, mot de passe vide
DB_HOST=localhost
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=hotel_db
# Mettre a true si la base en ligne exige SSL (Aiven, TiDB Cloud...)
DB_SSL=false
JWT_SECRET=change_me_par_une_longue_phrase_secrete
# URL du frontend (CORS). Plusieurs possibles, separees par des virgules
FRONTEND_URL=http://localhost:5173
